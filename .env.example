# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Atlas URI Connection String
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/bloxgain"

# JWT Secret Key for authentication sessions
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY"

# Roblox bot account cookie (.ROBLOSECURITY) for noblox.js Group Payout
ROBLOX_COOKIE="WARNING_DO_NOT_SHARE_THIS_COOKIE"

# Roblox Group ID for payout
ROBLOX_GROUP_ID="12345678"

# ayeT-Studios postback security verifier / api key
AYET_API_KEY="YOUR_AYET_API_KEY_OR_SECRET"

