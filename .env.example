# ==========================================
# BloxGain — Ortam Değişkenleri (.env) Örneği
# ==========================================
# Bu dosyayı ".env" adıyla kopyalayıp kendi gerçek değerlerinizi girin.
# ".env" dosyasını ASLA GitHub'a veya herhangi bir yere PAYLAŞMAYIN
# (.gitignore dosyasında zaten hariç tutulmuştur).

# ------------------------------------------
# MongoDB Atlas Bağlantı Adresi (ZORUNLU - Üretim için)
# ------------------------------------------
# Tanımlı değilse sunucu geçici bellek-içi (in-memory) veritabanına düşer;
# bu SADECE geliştirme/test içindir, sunucu yeniden başlatıldığında TÜM
# kullanıcı verileri silinir. Gerçek kullanıcılarla üretimde MUTLAKA
# MongoDB Atlas (veya başka kalıcı bir MongoDB) kullanın.
MONGODB_URI="mongodb+srv://kullanici:sifre@cluster.mongodb.net/bloxgain"

# ------------------------------------------
# JWT Gizli Anahtarı (ZORUNLU)
# ------------------------------------------
# Kullanıcı oturumlarını imzalamak için kullanılır. En az 32 rastgele
# karakter olmalı. Şu komutla güvenli bir tane üretebilirsiniz:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BU DEĞER TANIMLI DEĞİLSE VEYA ÇOK KISAYSA SUNUCU BAŞLAMAZ (güvenlik).
JWT_SECRET="BURAYA_UZUN_VE_RASTGELE_BIR_ANAHTAR_YAPISTIRIN"

# ------------------------------------------
# ayeT-Studios Postback API Anahtarı (ZORUNLU - Coin kazanma sistemi için)
# ------------------------------------------
# ayeT Studios yayıncı panelinizden alınır. Aşağıda "ayeT Studios API
# anahtarı nasıl alınır?" bölümünde adım adım anlatılmıştır.
# Tanımlı değilse /api/v1/callback/ayet uç noktası TAMAMEN DEVRE DIŞI
# kalır (güvenlik açığı oluşturmaz, sadece coin işlemez).
AYET_API_KEY="AYET_STUDIOS_PANELINIZDEKI_API_ANAHTARI"

# ------------------------------------------
# ayeT-Studios Offerwall / Placement ID (ZORUNLU - Frontend için)
# ------------------------------------------
# "VITE_" ön eki olan değişkenler tarayıcıya (frontend'e) gömülür, bu
# yüzden burada GİZLİ bir anahtar olmamalı — sadece herkese açık
# Offerwall ID'niz. Bu, kullanıcıların "Görevlere Git" butonuna
# bastığında açılacak sayfayı belirler.
VITE_AYET_OFFERWALL_ID="AYET_STUDIOS_OFFERWALL_ID_NIZ"

# ------------------------------------------
# Roblox Bot Hesabı Cookie'si (İSTEĞE BAĞLI — otomatik Robux ödemesi için)
# ------------------------------------------
# .ROBLOSECURITY cookie değeri. Bu, bir Roblox HESABINIZIN tam kontrolünü
# verir — ASLA kimseyle paylaşmayın, ASLA public bir repoya koymayın.
# Tanımlı değilse ödeme talepleri "Bekliyor" durumunda kuyruğa alınır ve
# kullanıcıya bu durum dürüstçe bildirilir (sahte "onaylandı" mesajı
# GÖSTERİLMEZ).
ROBLOX_COOKIE="WARNING_DO_NOT_SHARE_THIS_COOKIE"

# ------------------------------------------
# Sunucu Portu (İSTEĞE BAĞLI)
# ------------------------------------------
PORT=3000

# ------------------------------------------
# Ortam (production/development)
# ------------------------------------------
NODE_ENV=development
